!
interface GigaEthernet1:1.0
  description to as4-bdr1
  ip address 10.4.0.6/30
  ip ospf dead-interval 4
  ip ospf hello-interval 1
  ip ospf network point-to-point
  no shutdown
!
interface GigaEthernet1:2.0
  description to as4-bdr2
  ip address 10.4.0.10/30
  ip ospf dead-interval 4
  ip ospf hello-interval 1
  ip ospf network point-to-point
  no shutdown
!
interface GigaEthernet1:3.0
  description spare
  no ip address
  shutdown
!
interface GigaEthernet1:4.0
  description mgmt (VLAN104 to mgmt-srv)
  ip address 192.168.104.1/24
  ip filter mgmt-in 1 in
