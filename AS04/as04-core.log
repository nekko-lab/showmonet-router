router bgp 65004
  router-id 10.4.255.3
  neighbor 10.4.255.1 remote-as 65004
  neighbor 10.4.255.1 update-source Loopback0.0
  neighbor 10.4.255.1 connect-interval 10
  neighbor 10.4.255.1 timers 1 3
  neighbor 10.4.255.1 advertisement-interval 0
  neighbor 10.4.255.2 remote-as 65004
  neighbor 10.4.255.2 update-source Loopback0.0
  neighbor 10.4.255.2 connect-interval 10
  neighbor 10.4.255.2 timers 1 3
  neighbor 10.4.255.2 advertisement-interval 0
!
ip router ospf 1
  router-id 10.4.255.3
  timers delay 1 hold 1
  passive-interface Loopback0.0
  passive-interface GigaEthernet1:3.0
  passive-interface GigaEthernet1:4.0
  passive-interface GigaEthernet0.0
  area 0
